{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        // Workers and the exception handler already report these failures with backoff; EF would
        // otherwise repeat each one as a full stack trace on every connection attempt.
        "Microsoft.EntityFrameworkCore.Database.Connection": "Fatal",
        "Microsoft.EntityFrameworkCore.Query": "Fatal"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Jwt": {
    "Issuer": "NeverOrder",
    "Audience": "NeverOrderClients",
    "AccessTokenMinutes": 60,
    "SigningKey": ""
  },
  "Checkout": {
    "DeliveryFee": 0
  },
  "OrderSimulation": {
    "CreatedToConfirmed": "00:00:02",
    "ConfirmedToPreparing": "00:00:05",
    "PreparingToOutForDelivery": "00:00:05",
    "OutForDeliveryToDelivered": "00:00:08",
    "PollInterval": "00:00:00.500",
    "BatchSize": 50
  },
  "RabbitMq": {
    "Enabled": true,
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "neverorder",
    "Password": "",
    "VirtualHost": "/",
    "Exchange": "neverorder.events",
    "OrdersQueue": "neverorder.orders",
    "OrdersRoutingKey": "order.*",
    "PrefetchCount": 10,
    "ClientProvidedName": "neverorder-api",
    "ReconnectDelay": "00:00:05"
  },
  "Retry": {
    "MaxAttempts": 4,
    "BackoffSeconds": [ 1, 2, 4, 8 ]
  },
  "Outbox": {
    "PollInterval": "00:00:00.500",
    "BatchSize": 50,
    "PublishRetryDelay": "00:00:05"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Cache": {
    "Enabled": true,
    // Empty means an in-process cache. Set a StackExchange.Redis connection string to share one.
    "Redis": "",
    "InstanceName": "neverorder:",
    "VersionTimeToLive": "1.00:00:00",
    "Catalog": {
      "TimeToLive": "00:05:00"
    }
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 100,
      "Window": "00:01:00"
    },
    "Auth": {
      "PermitLimit": 10,
      "Window": "00:01:00"
    }
  },
  "Seed": {
    "Enabled": false
  }
}
